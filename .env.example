# --- workers/pool.py ---
MODEL_NAME=tiny
DEVICE=cpu
COMPUTE_TYPE=int8
# Leave blank to default to (CPU count - 1); set explicitly to cap
# worker count in a memory-constrained deployment.
POOL_WORKERS= 

# --- cache/redis_cache.py ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- services/pipeline.py (local_cache.LocalCache) ---
LOCAL_CACHE_MAX_SIZE=2048
LOCAL_CACHE_TTL_SECONDS=3600

# --- main.py ---
LOG_LEVEL=INFO
